<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
  # La demo de reconocimiento facial usa la cámara solo en este origen
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(wasm|js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Enrutar invisiblemente hyder.com.ar a la carpeta HyderLipy
  RewriteCond %{HTTP_HOST} ^(www\.)?hyder\.com\.ar$ [NC]
  RewriteCond %{REQUEST_URI} !^/HyderLipy/
  RewriteRule ^(.*)$ /HyderLipy/$1 [L]

  # 1b. Un solo dominio canónico: sin www y con HTTPS (solo arrambidetech.com)
  RewriteCond %{HTTP_HOST} ^www\.arrambidetech\.com$ [NC]
  RewriteRule ^(.*)$ https://arrambidetech.com/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^arrambidetech\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://arrambidetech.com/$1 [R=301,L]

  # 2. Reglas de Angular PARA EL PORTFOLIO PRINCIPAL
  # CRÍTICO: Excluimos la carpeta HyderLipy para que no secuestre sus rutas
  # Solo las rutas reales devuelven la app con estado 200; cualquier otra cae en
  # ErrorDocument y responde 404 (la app muestra la página "no encontrada").
  RewriteCond %{REQUEST_URI} !^/HyderLipy/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule ^(servicios|soluciones|contacto)/?$ $1/index.html [NC,L]
</IfModule>

ErrorDocument 404 /404.html
