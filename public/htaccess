<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
  # La demo de reconocimiento facial usa la cámara solo en este origen
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(wasm|js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Enrutar invisiblemente hyder.com.ar a la carpeta HyderLipy
  RewriteCond %{HTTP_HOST} ^(www\.)?hyder\.com\.ar$ [NC]
  RewriteCond %{REQUEST_URI} !^/HyderLipy/
  RewriteRule ^(.*)$ /HyderLipy/$1 [L]

  # 2. Reglas de Angular PARA EL PORTFOLIO PRINCIPAL
  # CRÍTICO: Excluimos la carpeta HyderLipy para que no secuestre sus rutas
  # Solo las rutas reales devuelven la app con estado 200; cualquier otra cae en
  # ErrorDocument y responde 404 (la app muestra la página "no encontrada").
  RewriteCond %{REQUEST_URI} !^/HyderLipy/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule ^(servicios|soluciones|contacto)/?$ index.html [NC,L]
</IfModule>

ErrorDocument 404 /index.html
